# Integration-test configuration. Copy to .env (gitignored) and fill in.
#
# Constitution I: never commit the filled-in file, and never paste a real value
# into source, a test, a doc, a fixture or a commit message. The leak gate
# blocks that, and it is right to.
#
# The live fixture's address changes on every restore, so look it up rather
# than copying it -- a stale value reads as a firewall or code fault, which has
# already caused a mis-diagnosis more than once.

XMLA_TEST_HOST=
XMLA_TEST_PORT=
XMLA_TEST_MECHANISM=ntlm
XMLA_TEST_USER=
XMLA_TEST_PASSWORD=
XMLA_TEST_CATALOG=
