#!/usr/bin/env bash
# Leak-gate: block a commit whose staged file CONTENTS contain identifying tokens.
# Content-based, correct exit codes. Constitution principle I.
# Real host/IP/SID/connection-strings are blocked; reserved/loopback/documentation
# addresses (127.x, 0.0.0.0, RFC-5737 192.0.2/198.51.100/203.0.113) are allowed —
# they are networking constants / test data, not "the host". Container image tags
# (`openmetadata/ingestion:2.0.1.0`) are dotted-quad shaped but name a release, so
# they are excluded from the address scan too.
set -euo pipefail

nonip='(\bWIN-[A-Z0-9]{6,}\b)|(\bS-1-([0-9]+-)+[0-9]+\b)|((Data Source|Initial Catalog|User ID|Password)=)'
allow_ip='^(127\.|0\.0\.0\.0$|192\.0\.2\.|198\.51\.100\.|203\.0\.113\.|255\.255\.255\.)'

# Whether an empty file list is an error depends on who asked. A caller that named
# its own command (CI scanning every tracked file) meant to scan something, so zero
# files is a broken invocation. The default staged-files command legitimately yields
# nothing for a message-only `--amend` or a merge commit, and blocking those would
# be a false refusal.
#
# Assigned BEFORE the functions that read it. It used to sit twenty lines below
# them and worked only because the first call happened later still; under `set -u`
# any reordering turns the gate into an immediate unbound-variable abort.
explicit_files_cmd="${LEAK_GATE_FILES_CMD:+yes}"

# The file list is indirected so CI can scan every tracked file with the SAME
# script, rather than reconstructing it with sed. A sed that stops matching after
# a reword silently produces a gate that scans nothing and exits 0 -- green while
# checking zero files, which is worse than having no job at all.
#
# R and T are in the filter deliberately. `--diff-filter=ACM` excludes renames,
# and `git diff --cached` has rename detection ON by default -- so `git mv a b`
# plus an edit that introduces a connection string produced an `R` entry, appeared
# in NO file list, and was never scanned in either direction. Verified: a rename
# detected at 62% similarity carrying `Data Source=` passed the gate. `--name-only`
# emits the new path for an R entry, which is the one to scan.
# NUL-delimited, and the file list command MUST emit NUL-delimited paths.
#
# With core.quotePath at its default, git renders a path containing non-ASCII
# bytes as a double-quoted, octal-escaped string -- "docs/caf\303\251.md". The
# loop then asked cat-file for a path including the literal quotes, that failed,
# and `|| continue` swallowed it: the file was silently NOT SCANNED. Fail-open,
# on any repository with a non-ASCII filename. -z suppresses that encoding
# entirely, which is more robust than turning quotePath off, because it also
# handles a newline in a path.
files_cmd="${LEAK_GATE_FILES_CMD:-git diff --cached --name-only -z --diff-filter=ACMRT}"

# Scan the STAGED blob, not the working-tree file.
#
# The gate's whole claim is about "a commit whose staged file CONTENTS contain
# identifying tokens", and it was reading `$f` off disk instead. Those diverge
# routinely, and the divergence fails OPEN: stage a file containing a connection
# string, edit the string out without re-staging, and the gate scans the cleaned
# working copy, finds nothing, and lets the staged secret through. The inverse
# also fires -- a clean staged version blocked by unstaged edits -- which trains
# people to reach for --no-verify.
#
# The same applies to the binary digest: hashing the working tree attests to a
# different blob than the one being committed, so an allowlist entry could vouch
# for content that is not what lands.
#
# When the caller supplied its own file list (CI scanning every tracked file)
# there is no index to read from, so the working tree IS the subject.
#
# The temp directory is created ONCE, HERE, in the parent shell. It was created
# inside `scan_target=$(materialise "$f")` -- a command substitution, therefore a
# subshell -- so the assignment never reached the parent: every staged file
# allocated a fresh `mktemp -d` that nothing recorded, and the cleanup trap always
# took its false branch. A commit staging twenty files left twenty directories in
# $TMPDIR, each holding the staged blob. That is the gate writing out the very
# secrets it exists to catch, and never deleting them. Verified before the fix:
# three staged files, three leaked directories.
scan_dir=""
if [ -z "$explicit_files_cmd" ]; then
  scan_dir=$(mktemp -d) || exit 1
fi

# `return 0` is load-bearing. An EXIT trap whose last command fails sets the
# script's exit status, so `[ -n "$scan_dir" ] && rm -rf ...` made EVERY run
# exit 1 when scan_dir was empty -- a gate that blocks everything, which reads
# exactly like a gate that is working.
cleanup() {
  if [ -n "$scan_dir" ]; then
    rm -rf "$scan_dir"
  fi
  return 0
}
trap cleanup EXIT

# Digest of a reviewed binary. Fails CLOSED: with no sha256 tool the placeholder
# matches no allowlist entry, so every binary is refused rather than waved past.
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d" " -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d" " -f1
  else echo "NO-SHA256-TOOL"; fi
}

leak=0
scanned=0
while IFS= read -r -d '' f; do
  # Resolved in the PARENT shell, not through a command substitution: a subshell
  # cannot record the temp directory it creates.
  #
  # `-f` on the working-tree path would be wrong here anyway. A file staged with
  # content and then deleted from disk is still going into the commit, and the
  # index is the authority for what that commit contains.
  if [ -n "$explicit_files_cmd" ]; then
    scan_target="$f"
    [ -f "$scan_target" ] || continue
  else
    # A SUBMODULE is a gitlink (mode 160000): the index entry is a commit id, not
    # a blob, so there is no content in THIS repository to scan. Skipping it is
    # correct and is checked explicitly by object type -- not folded into a
    # blanket failure handler, which is what previously hid real read errors.
    # The submodule's own contents are governed by its own repository.
    # Mode 160000 in the index is a gitlink. `git cat-file -t ":$f"` does NOT
    # report "commit" for one -- it fails outright with "could not get object
    # info" -- so the mode is the only reliable signal.
    # --literal-pathspecs: without it $f is a PATHSPEC and is glob-interpreted, so
    # a staged path containing * ? or [ queries whatever the glob matches rather
    # than the entry it names. If that first match is a gitlink, a real blob is
    # skipped unscanned.
    case "$(git --literal-pathspecs ls-files -s -- "$f" 2>/dev/null)" in
      160000\ *) continue ;;
    esac

    scan_target="$scan_dir/blob"
    # Any OTHER cat-file failure is an ERROR, not a skip.
    #
    # This used to `|| continue`, described as covering "staged as a deletion, or
    # unmerged" -- but --diff-filter=ACMRT excludes D and U, so neither can reach
    # here. What could reach here was a quoted path, a corrupt index, or a file
    # list produced from a different repository root, and every one of them was
    # discarded without a word: the gate reported clean on a file it never read.
    if ! git cat-file blob ":$f" > "$scan_target" 2>/dev/null; then
      echo "leak-gate: cannot read the staged content of: $f" >&2
      echo "  the gate will not report clean on a file it could not scan" >&2
      leak=1
      continue
    fi
  fi
  # Counted HERE, not at the end of the body: every `continue` below -- the hook
  # itself, and BOTH binary outcomes including an allowlisted one -- skipped the
  # increment, so a list of only reviewed binaries reported "the file list is
  # empty" when it was neither empty nor unscanned.
  scanned=$((scanned + 1))
  case "$f" in .githooks/pre-commit) continue;; esac
  # Binary files are INVISIBLE to this gate: grep -I skips them, so every check
  # below silently passes. A coverage database reached a public repo that way,
  # carrying 22 absolute paths from the author's home directory. Refuse binaries
  # rather than pretend to have scanned them.
  #
  # The emptiness test matches the empty LINE (`grep -qI ''`), not any character
  # (`grep -qI .`). A file of blank lines contains no matching character either,
  # so the narrower test refused a whitespace-only .gitkeep as "binary" -- the
  # same false refusal that hit py.typed, one byte away. `-I` still returns 1 for
  # a genuine binary, which is what actually distinguishes the two.
  #
  # Binaries reviewed by eye are recorded in .leakgate-allow AS A DIGEST AND PATH,
  # not a path alone. A path-only entry grants that path permanent immunity: a
  # re-captured screenshot now showing a hostname in the URL bar would pass
  # unreviewed, which is precisely the case the review is for. Keying on content
  # means replacing the file re-arms the gate.
  if [ -s "$scan_target" ] && ! grep -qI '' "$scan_target" 2>/dev/null; then
    digest=$(sha256_of "$scan_target")
    if [ -f .leakgate-allow ] && grep -qxF "$digest  $f" .leakgate-allow 2>/dev/null; then
      : # this exact content was reviewed by hand and recorded
    else
      echo "leak-gate: binary file cannot be scanned, refusing: $f" >&2
      echo "  review it by eye, then add this exact line to .leakgate-allow:" >&2
      echo "    $digest  $f" >&2
      leak=1
    fi
    continue
  fi

  # non-IP token classes
  if grep -qEI "$nonip" "$scan_target" 2>/dev/null; then
    echo "leak-gate: host/SID/connection-string token in: $f" >&2; leak=1
  fi
  # any IPv4 that is NOT in the allowlist. Each token carries its image-reference
  # prefix when it has one, so a version tag can be told apart from an address.
  while IFS= read -r ip; do
    # `registry/name:2.0.1.0` is an image tag, not a host. The exemption is a
    # WHITELIST of what an image reference looks like, not a blacklist of file
    # extensions: the blacklist version exempted anything it had not thought of --
    # `docker/Dockerfile:10.1.2.3`, `SRC/MAIN.PY:...`, `.rst`, `.tf`, `.conf` --
    # while the failure it exists to stop (`src/main.py:10.20.30.40`, a pasted grep
    # hit carrying a real address) is exactly that shape. So: exempt only when the
    # prefix is all lower-case image-name characters AND the segment before the
    # colon has no dot, which is true of `openmetadata/ingestion` and of
    # `docker.getcollate.io/openmetadata/ingestion`, and false of every file path
    # with an extension and of every capitalised filename.
    addr=${ip##*:}
    case "$ip" in
      */*:*)
        _prefix=${ip%%:*}
        case "$_prefix" in
          *[!a-z0-9._/-]*) ;;                   # uppercase etc: a path, keep scanning
          *) case "${_prefix##*/}" in
               *.*) ;;                          # last segment has an extension: a path
               *) continue ;;                   # an image reference: exempt
             esac ;;
        esac
        ;;
    esac
    # An IPv4 address has EXACTLY four components and is never embedded in a
    # longer dotted-decimal run. Anything longer is an OID, a version string or
    # similar -- 1.3.6.1.4.1.311.2.2.10 (the NTLMSSP mechanism OID) yields the
    # four-component windows '1.3.6.1' and '4.1.311.2', and the trailing \b in
    # the extraction does not prevent that because the next character is '.',
    # which satisfies the boundary. So the extraction takes the WHOLE run and
    # this rejects any run that is not exactly four components. Same spirit as
    # the image-reference exemption above: a whitelist of what an address looks
    # like, not a blacklist of what it does not.
    if [ "$(printf '%s' "$addr" | tr '.' '\n' | grep -c '')" -ne 4 ]; then
      continue
    fi
    # Test the ADDRESS, not the whole token: allow_ip is ^-anchored, so a loopback
    # or RFC-5737 address inside a grep-hit-shaped string ("docs/setup.md:127.0.0.1")
    # failed the anchor and was reported as a real address, with no way to express it.
    if ! printf '%s' "$addr" | grep -qE "$allow_ip"; then
      echo "leak-gate: non-reserved IP '$ip' in: $f" >&2; leak=1
    fi
    # An OBJECT IDENTIFIER is dotted decimal too, and a four-component window
    # inside one looks exactly like an address: 1.3.6.1.4.1.311.2.2.10 (the
    # NTLMSSP mechanism OID) yields both '1.3.6.1' and '4.1.311.2'. The trailing
    # \b does not stop it, because the character after the window is '.', which
    # is a non-word character and so satisfies the boundary.
    #
    # The discriminator is a WHITELIST of what an address looks like, in the same
    # spirit as the image-reference exemption above: an IPv4 address has EXACTLY
    # four components, and is never embedded in a longer dotted-decimal run. So
    # the extraction now takes the WHOLE run and anything with more than four
    # components is an OID, a version string, or something else that is not an
    # address. Four-component version numbers are still reported -- they are rare,
    # and a false positive that can be reworded is the right side to err on.
  done < <(grep -oEI '\b([A-Za-z0-9._-]+/[A-Za-z0-9._/-]*:)?[0-9]{1,3}(\.[0-9]{1,3})+\b' "$scan_target" 2>/dev/null | sort -u)
done < <(eval "$files_cmd")

# A gate that scanned nothing and exited 0 is worse than no gate: it is green while
# checking zero files. Indirecting the file list through $LEAK_GATE_FILES_CMD removed
# the sed-rewrite version of that failure and moved it into the variable -- a stale or
# mistyped command, or the wrong working directory, produces an empty list in silence.
# The leak verdict comes FIRST. With the order reversed, a list of only refused
# binaries printed the refusal and then "the file list is empty", which is both
# wrong and the last line the operator reads.
if [ "$leak" != 0 ]; then
  echo "COMMIT BLOCKED: remove real host/IP/SID/connection-string tokens (constitution I)." >&2
  exit 1
fi

if [ -n "$explicit_files_cmd" ] && [ "$scanned" -eq 0 ]; then
  echo "leak-gate: scanned 0 files -- the file list is empty, which is not a pass." >&2
  echo "  LEAK_GATE_FILES_CMD was: $files_cmd" >&2
  exit 1
fi
