#!/bin/sh
# roborev post-rewrite — remaps reviews after a rebase or amend.
#
# Non-blocking: a missing roborev is not an error, and neither is a review that
# does not enqueue. But FAILURE IS REPORTED. The original hook sent stderr to
# /dev/null and exited 0 on any problem, so a roborev that was installed but
# broken looked exactly like one working correctly — which is the same
# silent-failure mode the leak gate was found in, reintroduced for the review
# path.
#
# No hardcoded Homebrew prefix: this repository's CI covers Linux and macOS, and
# a path that is meaningful on one machine layout is dead weight everywhere else.
ROBOREV=$(command -v roborev 2>/dev/null)
if [ -z "$ROBOREV" ] || [ ! -x "$ROBOREV" ]; then
    exit 0
fi
if ! "$ROBOREV" remap --quiet; then
    echo "roborev: post-rewrite hook exited non-zero (review not enqueued)" >&2
fi
exit 0
